OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local Hugging Face model used for RAG answers and training
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# cuda, mps (Apple Silicon) or cpu; blank = auto-detect
LOCAL_LLM_DEVICE=
# 4-bit loading (needs bitsandbytes + an NVIDIA GPU); Qwen2.5-7B then uses ~6 GB VRAM
LOCAL_LLM_4BIT=1
# Max prompt + reply tokens for the local model (0 = the model's own limit)
LOCAL_LLM_MAX_CONTEXT=8192

# Path to a LoRA/PEFT adapter dir (e.g. data/tax_lora_adapter) to enable fine-tuned mode
TAX_MODEL_ADAPTER=

# Force device for training scripts (cuda|cpu)
TAX_TRAIN_DEVICE=

# Login: secret used to sign session tokens (set a long random value)
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# Initial account, created only when no users exist yet (stored hashed in data/users.db).
# Change the password after first login.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin123

# Minimum similarity (0-1) between a point of an answer and a passage of the Act for the
# point to be shown with that passage as its source; points below it are hidden.
# Lower shows more points but lets more unsupported claims through.
CITATION_MIN_SIMILARITY=0.45
